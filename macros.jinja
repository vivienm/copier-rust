{# JSON permits a literal DEL character, but TOML requires it to be escaped. #}
{% macro toml_string(value) -%}
{{ value | to_json(ensure_ascii=False) | replace('\x7f', '\\u007f') }}
{%- endmacro %}

{% macro nix_string(value) -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('${', '\\${') | replace('\n', '\\n') | replace('\r', '\\r') | replace('\t', '\\t') }}"
{%- endmacro %}
