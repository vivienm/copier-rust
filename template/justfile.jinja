set shell := ["bash", "-uc"]

ci: lint audit{% if project_type == "library" %} doc{% endif %} test

lint: fmt clippy typos

fmt:
    cargo fmt --check

[positional-arguments]
check *args:
    cargo check --all-targets{% if project_type == "library" %} --all-features{% endif %} "$@"

[positional-arguments]
clippy *args:
    cargo clippy --all-targets{% if project_type == "library" %} --all-features{% endif %} "$@"

[positional-arguments]
test *args:
    cargo test{% if project_type == "library" %} --all-features{% endif %} "$@"

[positional-arguments]
doc *args:
    cargo doc --no-deps{% if rust_toolchain == "nightly" or rust_toolchain.startswith("nightly-") %} -Zrustdoc-map{% endif %}{% if project_type == "library" %} --all-features{% endif %} "$@"

audit:
    cargo audit

typos:
    typos
