{% from "macros.jinja" import toml_string %}
[package]
name = {{ toml_string(package_name) }}
version = "0.1.0"
edition = "2024"
description = {{ toml_string(project_description.removesuffix('.')) }}
{% if forge != "none" %}
repository = {{ toml_string(repo_url) }}
{% endif %}
{% if github_pages %}
documentation = {{ toml_string(pages_url ~ '/docs/' ~ (package_name | replace('-', '_')) ~ '/') }}
{% endif %}
license = {{ toml_string('LicenseRef-Proprietary' if license == 'Proprietary' else license) }}
publish = false

{% if project_type == "library" %}
[lints.rust]
missing_debug_implementations = "warn"
missing_docs = "warn"

{% endif %}
[dependencies]
{% if project_type == "application" %}
anyhow = "1.0.104"
clap = { version = "4.6.7", features = ["cargo", "derive", "env"] }
clap_complete = "4.6.11"
tracing = "0.1.44"
tracing-subscriber = "0.3.23"
{% endif %}
